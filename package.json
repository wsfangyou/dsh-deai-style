{
  "name": "dsh-deai-style",
  "version": "0.1.0",
  "description": "DSH 去 AI 味插件（人类文风）：AI 味不是修辞毛病而是统计指纹——低困惑度、低突发度、套话密度高、结构模板化。可开关的提示段按覆盖档注入（core = 清套话 + 打散句长起伏 / full = 再加篇章与信息层），文体档（通用/学术/随笔）决定强度，事实护栏恒在：只改表达，不改数字、引用与结论",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-system-prompt": "^0.2.0-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  }
}
